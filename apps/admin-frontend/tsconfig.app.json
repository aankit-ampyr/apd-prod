{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {"@/*": ["src/*"]}
  },
  "include": [
    "src",
    "../../packages/react-common/src/ui-kit/Pagination",
    "../../packages/react-common/src/ui-kit/TextInput",
    "../../packages/react-common/src/ui-kit/Toggle",
    "../../packages/react-common/src/ui-kit/sort",
    "../../packages/react-common/src/ui-kit/DatePicker",
    "../../packages/react-common/src/ui-kit/Radio",
    "../../packages/react-common/src/ui-kit/Toast"
, "../../packages/react-common/src/ui-kit/Avatar"  ]
}
